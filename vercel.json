{
  "buildCommand": "npm run build:production",
  "crons": [
    {
      "path": "/api/cron/inbound-email-forward-alert",
      "schedule": "0 12 * * *"
    }
  ],
  "github": {
    "silent": false
  },
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
